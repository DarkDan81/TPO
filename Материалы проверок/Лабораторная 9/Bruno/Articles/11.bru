meta {
  name: Изменение статьи
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/v1/pages/{{tempId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

body:json {
  {"id": 12, "userId": 5, "title": "LAB9 Изменено", "content": "Новый текст", "categoryId": 1}
}

assert {
  res.status: eq 200
}
